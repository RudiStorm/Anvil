@page "/overview"
@inject ProductCatalog Catalog
@inject RequestContext Request

<PageTitle>Overview | Anvil</PageTitle>

<div class="page-heading"><div><p class="eyebrow">Tuesday, September 29, 2026</p><h1>Good morning, Jordan <span class="wave">✦</span></h1><p class="lede">Here’s what’s happening across your workspace today.</p></div><button class="button button-primary" type="button">+ Create report</button></div>

<section class="metric-grid" aria-label="Business metrics">
    @foreach (var metric in Catalog.Metrics)
    {
        <article class="metric-card"><div class="metric-card-top"><span class="metric-label">@metric.Label</span><span class="metric-icon">↗</span></div><strong class="metric-value">@metric.Value</strong><span class="metric-change positive">@metric.Change <span>vs last month</span></span></article>
    }
</section>

<div class="dashboard-grid">
    <section class="panel revenue-panel"><div class="panel-heading"><div><h2>Revenue overview</h2><p>Monthly performance</p></div><select aria-label="Revenue period"><option>Last 30 days</option><option>Last 90 days</option></select></div><div class="chart"><div class="chart-y"><span>$50k</span><span>$40k</span><span>$30k</span><span>$20k</span><span>$10k</span><span>$0</span></div><div class="chart-body"><div class="chart-bars"><i style="height:34%"></i><i style="height:46%"></i><i style="height:40%"></i><i style="height:61%"></i><i style="height:55%"></i><i style="height:76%"></i><i style="height:92%"></i></div><div class="chart-x"><span>Mar 01</span><span>Mar 07</span><span>Mar 14</span><span>Mar 21</span><span>Mar 28</span></div></div></div></section>
    <section class="panel activity-panel"><div class="panel-heading"><div><h2>Recent activity <span class="live-badge"><i></i> Live</span></h2><p>Updates replace this region without a page reload.</p></div><div class="panel-actions"><button class="text-button" type="button" data-anvil-get="/api/dashboard/activity" data-anvil-target="#dashboard-activity">Refresh</button><a class="text-link" href="@Request.Link("/team")">View all</a></div></div><AnvilLiveRegion Id="dashboard-activity" Url="/api/dashboard/activity" IntervalMs="5000"><div class="activity-list">
        @foreach (var item in Catalog.RecentActivity)
        {
            <div class="activity-item"><span class="avatar avatar-@item.Tone">@item.Initials</span><div><p>@item.Description</p><small>@item.Time</small></div></div>
        }
    </div></AnvilLiveRegion></section>
</div>

<section class="panel quick-panel"><div class="panel-heading"><div><h2>Quick actions</h2><p>Common tasks for your team</p></div></div><div class="quick-actions"><a href="@Request.Link("/products")"><span>＋</span><strong>Add inventory</strong><small>Create a new product listing</small></a><a href="@Request.Link("/team")"><span>♧</span><strong>Invite teammate</strong><small>Grow your operations team</small></a><a href="@Request.Link("/settings")"><span>⚙</span><strong>Workspace settings</strong><small>Manage preferences</small></a></div></section>
