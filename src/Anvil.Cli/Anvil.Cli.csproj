<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>anvil</ToolCommandName>
    <PackageId>Raukeld.Anvil.Cli</PackageId>
    <Version>0.1.2</Version>
    <Authors>Anvil contributors</Authors>
    <Description>CLI tools for Anvil applications.</Description>
    <PackageTags>dotnet;web;razor;ssr</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anvil\Anvil.csproj" />
    <InternalsVisibleTo Include="Anvil.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
