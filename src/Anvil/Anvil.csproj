<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Anvil</RootNamespace>
    <PackageId>Anvil</PackageId>
    <Version>0.1.0</Version>
    <Authors>Anvil contributors</Authors>
    <Description>Server-rendered .NET application framework built on ASP.NET Core and Razor.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>aspnetcore;razor;server-rendered;htmx</PackageTags>
    <PackageReadmeFile>PACKAGE-NOTICE.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <None Include="PACKAGE-NOTICE.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
