{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=anvil-store.db"
  },
  "Store": {
    "StorageRoot": "store-storage",
    "ApplyMigrationsOnStartup": true,
    "MalwareScanner": {
      "Host": "localhost",
      "Port": 3310,
      "Required": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
