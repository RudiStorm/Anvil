<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <ProjectReference Include="..\Anvil\Anvil.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Anvil.Razor</RootNamespace>
    <PackageId>Raukeld.Anvil.Razor</PackageId>
    <Version>0.1.2</Version>
    <Authors>Anvil contributors</Authors>
    <Description>Razor components and browser runtime for the Anvil server-rendered framework.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>aspnetcore;razor;server-rendered;htmx</PackageTags>
    <PackageReadmeFile>PACKAGE-NOTICE.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="PACKAGE-NOTICE.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
