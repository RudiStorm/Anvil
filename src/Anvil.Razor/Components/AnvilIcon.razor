<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="@(string.IsNullOrWhiteSpace(Label) ? "img" : null)" aria-label="@Label" aria-hidden="@(string.IsNullOrWhiteSpace(Label) ? "true" : null)">
    <path d="@Path" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
</svg>

@code {
    [Parameter, EditorRequired]
    public string Path { get; set; } = string.Empty;

    [Parameter]
    public string? Label { get; set; }
}
